generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  quotes       Quote[]
}

model Quote {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  age                    Int
  annualIncome           Decimal  @db.Decimal(12, 2)
  partnerAnnualIncome    Decimal  @db.Decimal(12, 2)
  monthlyExpenses        Decimal  @db.Decimal(12, 2)
  dependants             Int
  mortgageBalance        Decimal  @db.Decimal(12, 2)
  otherDebts             Decimal  @db.Decimal(12, 2)
  savings                Decimal  @db.Decimal(12, 2)
  existingLifeCover      Decimal  @db.Decimal(12, 2)
  incomeReplacementYears Int

  recommendedCoverAmount Decimal  @db.Decimal(12, 2)
  estimatedMonthlyPremium Decimal @db.Decimal(12, 2)
  riskBand               String
  recommendationSummary  String

  createdAt              DateTime @default(now())

  @@index([userId])
}